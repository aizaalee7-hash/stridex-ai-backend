# Copy this file to .env for local development.
# Paste your real API key only in .env or your hosting provider's Environment settings.
OPENAI_API_KEY=replace_with_your_secret_key
OPENAI_MODEL=gpt-5.5
PORT=3000

# Set these to the exact origin(s) that will call the API, comma-separated.
# Example: https://aizaalee7-hash.github.io
ALLOWED_ORIGINS=https://aizaalee7-hash.github.io,http://127.0.0.1:5500,http://localhost:5500
